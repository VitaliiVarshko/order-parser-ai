# --- Mistral API ---
MISTRAL_API_KEY=your_api_key_here

# --- Qdrant ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="nomenclature"

# --- Paths ---
CSV_PATH="path/to/your/tov.csv"
LOG_DIR="path/to/logs"

# --- Logging ---
LOG_ENABLED=True
LOG_ENABLED_TOV=True
LOG_DIR_TOV="path/to/logs/tov"

# --- Search ---
CONFIDENCE_THRESHOLD=0.5
SEARCH_RESULTS=10

# --- Providers ---
EMBEDDING_PROVIDER="mistral"
LLM_PROVIDER="mistral"
